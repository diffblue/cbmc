; bf16: a * 2.0 == a + a (multiplication by constant)
(set-logic QF_FP)
(declare-fun a () (_ FloatingPoint 8 8))
(assert (not (fp.isNaN a)))
(assert (not (fp.isInfinite a)))
(define-fun two () (_ FloatingPoint 8 8) ((_ to_fp 8 8) RNE 2.0))
(assert (not (= (fp.mul RNE a two) (fp.add RNE a a))))
(check-sat)
(exit)
