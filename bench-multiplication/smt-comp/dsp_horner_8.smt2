(set-logic QF_BV)
(declare-fun x () (_ BitVec 8))
(define-fun direct () (_ BitVec 8)
  (bvadd (_ bv3 8)
         (bvmul (_ bv5 8) x)
         (bvmul (_ bv2 8) (bvmul x x))
         (bvmul x (bvmul x x))))
(define-fun horner () (_ BitVec 8)
  (bvadd (_ bv3 8) (bvmul x (bvadd (_ bv5 8) (bvmul x (bvadd (_ bv2 8) x))))))
(assert (not (= direct horner)))
(check-sat)
