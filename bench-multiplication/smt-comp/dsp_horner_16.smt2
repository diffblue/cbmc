(set-logic QF_BV)
(declare-fun x () (_ BitVec 16))
(define-fun direct () (_ BitVec 16)
  (bvadd (_ bv3 16)
         (bvmul (_ bv5 16) x)
         (bvmul (_ bv2 16) (bvmul x x))
         (bvmul x (bvmul x x))))
(define-fun horner () (_ BitVec 16)
  (bvadd (_ bv3 16) (bvmul x (bvadd (_ bv5 16) (bvmul x (bvadd (_ bv2 16) x))))))
(assert (not (= direct horner)))
(check-sat)
