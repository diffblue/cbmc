; 8-addition equivalence: two different orderings produce same result
(set-logic QF_BV)
(declare-fun a () (_ BitVec 16))
(declare-fun b () (_ BitVec 16))
(declare-fun c () (_ BitVec 16))
(declare-fun d () (_ BitVec 16))
(declare-fun e () (_ BitVec 16))
(declare-fun f () (_ BitVec 16))
(declare-fun g () (_ BitVec 16))
(declare-fun h () (_ BitVec 16))
(define-fun lhs () (_ BitVec 16)
  (bvadd (bvadd (bvadd a b) (bvadd c d))
         (bvadd (bvadd e f) (bvadd g h))))
(define-fun rhs () (_ BitVec 16)
  (bvadd (bvadd (bvadd h g) (bvadd f e))
         (bvadd (bvadd d c) (bvadd b a))))
(assert (not (= lhs rhs)))
(check-sat)
(exit)
