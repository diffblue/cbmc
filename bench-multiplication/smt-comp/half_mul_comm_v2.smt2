(set-logic QF_FP)
(declare-fun a () (_ FloatingPoint 5 11))
(declare-fun b () (_ FloatingPoint 5 11))
(assert (not (fp.isNaN a)))
(assert (not (fp.isNaN b)))
(define-fun p1 () (_ FloatingPoint 5 11) (fp.mul RNE a b))
(define-fun p2 () (_ FloatingPoint 5 11) (fp.mul RNE b a))
(assert (not (fp.isNaN p1)))
(assert (not (= p1 p2)))
(check-sat)
(exit)
