(set-logic QF_BV)
; 7x * 3x == (7*3)x^2 (e.g., 3x * 5x == 15 x^2)
(declare-fun x () (_ BitVec 16))
(define-fun p1 () (_ BitVec 16) (bvmul (_ bv7 16) x))
(define-fun p2 () (_ BitVec 16) (bvmul (_ bv3 16) x))
(define-fun result () (_ BitVec 16) (bvmul p1 p2))
(define-fun expected () (_ BitVec 16) (bvmul (_ bv21 16) (bvmul x x)))
(assert (not (= result expected)))
(check-sat)
