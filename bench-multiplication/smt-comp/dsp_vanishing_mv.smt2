(set-logic QF_BV)
(declare-fun x1 () (_ BitVec 1))
(declare-fun x2 () (_ BitVec 2))
(define-fun X1 () (_ BitVec 3) ((_ zero_extend 2) x1))
(define-fun X2 () (_ BitVec 3) ((_ zero_extend 1) x2))
(define-fun poly () (_ BitVec 3)
  (bvadd (bvmul X1 X1)
         (bvmul (_ bv7 3) X1)
         (bvmul (_ bv4 3) (bvmul X1 (bvmul X2 X2)))
         (bvmul (_ bv4 3) (bvmul X1 X2))))
(assert (not (= poly (_ bv0 3))))
(check-sat)
