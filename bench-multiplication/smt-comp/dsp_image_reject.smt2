(set-logic QF_BV)
(declare-fun a () (_ BitVec 12))
(declare-fun b () (_ BitVec 8))
(define-fun A () (_ BitVec 16) ((_ zero_extend 4) a))
(define-fun B () (_ BitVec 16) ((_ zero_extend 8) b))
(define-fun A2 () (_ BitVec 16) (bvmul A A))
(define-fun B2 () (_ BitVec 16) (bvmul B B))
(define-fun A4 () (_ BitVec 16) (bvmul A2 A2))
(define-fun B4 () (_ BitVec 16) (bvmul B2 B2))
(define-fun AB () (_ BitVec 16) (bvmul A B))
(define-fun F () (_ BitVec 16)
  (bvadd (bvmul (_ bv16384 16) (bvadd A4 B4))
         (bvmul (_ bv64767 16) (bvsub A2 B2))
         (bvsub A B)
         (bvmul (_ bv57344 16) (bvmul AB (bvsub A B)))))
(define-fun G () (_ BitVec 16)
  (bvadd (bvmul (_ bv24576 16) (bvmul A2 B))
         (bvmul (_ bv15615 16) A2)
         (bvmul (_ bv8192 16) (bvmul A B2))
         (bvmul (_ bv32768 16) AB)
         A
         (bvmul (_ bv17153 16) B2)
         (bvmul (_ bv65535 16) B)))
(assert (not (= F G)))
(check-sat)
