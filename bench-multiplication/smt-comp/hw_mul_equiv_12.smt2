; Hardware multiplier equivalence: two different implementations
; produce the same result. This is a real hardware verification task.
(set-logic QF_BV)
(declare-fun a () (_ BitVec 12))
(declare-fun b () (_ BitVec 12))
; Implementation 1: direct multiplication
(define-fun prod1 () (_ BitVec 12) (bvmul a b))
; Implementation 2: shift-and-add (manual)
(define-fun pp0 () (_ BitVec 12) (ite (= ((_ extract 0 0) b) #b1) a (_ bv0 12)))
(define-fun pp1 () (_ BitVec 12) (ite (= ((_ extract 1 1) b) #b1) (bvshl a (_ bv1 12)) (_ bv0 12)))
(define-fun pp2 () (_ BitVec 12) (ite (= ((_ extract 2 2) b) #b1) (bvshl a (_ bv2 12)) (_ bv0 12)))
(define-fun pp3 () (_ BitVec 12) (ite (= ((_ extract 3 3) b) #b1) (bvshl a (_ bv3 12)) (_ bv0 12)))
(define-fun pp4 () (_ BitVec 12) (ite (= ((_ extract 4 4) b) #b1) (bvshl a (_ bv4 12)) (_ bv0 12)))
(define-fun pp5 () (_ BitVec 12) (ite (= ((_ extract 5 5) b) #b1) (bvshl a (_ bv5 12)) (_ bv0 12)))
(define-fun pp6 () (_ BitVec 12) (ite (= ((_ extract 6 6) b) #b1) (bvshl a (_ bv6 12)) (_ bv0 12)))
(define-fun pp7 () (_ BitVec 12) (ite (= ((_ extract 7 7) b) #b1) (bvshl a (_ bv7 12)) (_ bv0 12)))
(define-fun pp8 () (_ BitVec 12) (ite (= ((_ extract 8 8) b) #b1) (bvshl a (_ bv8 12)) (_ bv0 12)))
(define-fun pp9 () (_ BitVec 12) (ite (= ((_ extract 9 9) b) #b1) (bvshl a (_ bv9 12)) (_ bv0 12)))
(define-fun pp10 () (_ BitVec 12) (ite (= ((_ extract 10 10) b) #b1) (bvshl a (_ bv10 12)) (_ bv0 12)))
(define-fun pp11 () (_ BitVec 12) (ite (= ((_ extract 11 11) b) #b1) (bvshl a (_ bv11 12)) (_ bv0 12)))
(define-fun prod2 () (_ BitVec 12) (bvadd pp0 (bvadd pp1 (bvadd pp2 (bvadd pp3 (bvadd pp4 (bvadd pp5 (bvadd pp6 (bvadd pp7 (bvadd pp8 (bvadd pp9 (bvadd pp10 pp11))))))))))))
(assert (not (= prod1 prod2)))
(check-sat)
(exit)
