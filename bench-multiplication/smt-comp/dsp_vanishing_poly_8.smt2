(set-logic QF_BV)
(declare-fun x () (_ BitVec 8))
(define-fun x2 () (_ BitVec 8) (bvmul x x))
(define-fun x3 () (_ BitVec 8) (bvmul x2 x))
(define-fun x4 () (_ BitVec 8) (bvmul x2 x2))
(define-fun x5 () (_ BitVec 8) (bvmul x4 x))
(define-fun x6 () (_ BitVec 8) (bvmul x4 x2))
(define-fun x7 () (_ BitVec 8) (bvmul x4 x3))
(define-fun x8 () (_ BitVec 8) (bvmul x4 x4))
(define-fun x9 () (_ BitVec 8) (bvmul x8 x))
(define-fun x10 () (_ BitVec 8) (bvmul x8 x2))
; Y_10(x) = x(x-1)(x-2)...(x-9) vanishes mod 2^8 since SF(256)=10
; Expanded: x^10 + 211*x^9 + 102*x^8 + 22*x^7 + 41*x^6 + 243*x^5 + 224*x^4 + 36*x^3 + 16*x^2 + 128*x
(define-fun poly () (_ BitVec 8)
  (bvadd x10
         (bvmul (_ bv211 8) x9)
         (bvmul (_ bv102 8) x8)
         (bvmul (_ bv22 8) x7)
         (bvmul (_ bv41 8) x6)
         (bvmul (_ bv243 8) x5)
         (bvmul (_ bv224 8) x4)
         (bvmul (_ bv36 8) x3)
         (bvmul (_ bv16 8) x2)
         (bvmul (_ bv128 8) x)))
(assert (not (= poly (_ bv0 8))))
(check-sat)
