(set-logic QF_BV)
; 3x * 5x == (3*5)x^2 (e.g., 3x * 5x == 15 x^2)
(declare-fun x () (_ BitVec 8))
(define-fun p1 () (_ BitVec 8) (bvmul (_ bv3 8) x))
(define-fun p2 () (_ BitVec 8) (bvmul (_ bv5 8) x))
(define-fun result () (_ BitVec 8) (bvmul p1 p2))
(define-fun expected () (_ BitVec 8) (bvmul (_ bv15 8) (bvmul x x)))
(assert (not (= result expected)))
(check-sat)
