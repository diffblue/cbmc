CORE
main.cpp
--cpp11
^\[main\.assertion\.1\] line \d+ assigned through iterator: SUCCESS$
^VERIFICATION SUCCESSFUL$
^EXIT=0$
^SIGNAL=0$
--
--
decltype of an indirection must be T& ([dcl.type.decltype]/1.5,
[expr.unary.op]/1); it used to collapse to T, breaking assignment
through iterators whose operator* return type is iter_reference_t.
