CORE libcxx
sort_types.cpp
--cpp20 --stdlib libc++ --unwind 8 --object-bits 12
^\[main\.assertion\.1\] line \d+ double: SUCCESS$
^\[main\.assertion\.2\] line \d+ unsigned, less: SUCCESS$
^\[main\.assertion\.3\] line \d+ one element and empty ranges: SUCCESS$
^\[main\.assertion\.4\] line \d+ char: SUCCESS$
^\[main\.assertion\.5\] line \d+ WRONG \(must FAIL\): FAILURE$
^VERIFICATION FAILED$
