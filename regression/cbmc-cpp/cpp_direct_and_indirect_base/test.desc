^\[main\.assertion\.1\] line \d+ A's L: SUCCESS$
^\[main\.assertion\.2\] line \d+ direct L: SUCCESS$
^\[main\.assertion\.3\] line \d+ qualified member: SUCCESS$
^\[main\.assertion\.4\] line \d+ copy assignment: SUCCESS$
^\[main\.assertion\.5\] line \d+ copy construction: SUCCESS$
^\[main\.assertion\.6\] line \d+ two L subobjects: SUCCESS$
^\[main\.assertion\.7\] line \d+ WRONG \(must FAIL\): FAILURE$
^VERIFICATION FAILED$
^EXIT=10$
