^\[main\.assertion\.1\] line \d+ bool <=> bool equal: SUCCESS$
^\[main\.assertion\.2\] line \d+ false < true: SUCCESS$
^\[main\.assertion\.3\] line \d+ comparison result <=> true: SUCCESS$
