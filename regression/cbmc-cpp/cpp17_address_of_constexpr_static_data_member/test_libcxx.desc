CORE libcxx
libcxx.cpp
--cpp17 --stdlib libc++ --object-bits 10
^\[main\.assertion\.1\] line \d+ has_value: SUCCESS$
^\[main\.assertion\.2\] line \d+ WRONG \(must FAIL\): FAILURE$
^VERIFICATION FAILED$
^EXIT=10$
