CORE
main.cpp

^\[main\.assertion\.1\] line \d+ cooked integer: SUCCESS$
^\[main\.assertion\.2\] line \d+ cooked floating: SUCCESS$
^\[main\.assertion\.3\] line \d+ raw integer: SUCCESS$
^\[main\.assertion\.4\] line \d+ raw floating: SUCCESS$
^\[main\.assertion\.5\] line \d+ template integer: SUCCESS$
^\[main\.assertion\.6\] line \d+ template floating: SUCCESS$
^\[main\.assertion\.7\] line \d+ digit separator in the spelling: SUCCESS$
^\[main\.assertion\.8\] line \d+ template characters: SUCCESS$
^\[main\.assertion\.9\] line \d+ suffix beginning with u: SUCCESS$
