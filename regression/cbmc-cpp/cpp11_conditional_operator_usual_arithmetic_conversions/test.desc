CORE
main.cpp
--cpp11
^\[main\.assertion\.1\] .* char, short: int: SUCCESS$
^\[main\.assertion\.2\] .* same type: lvalue kept \(/4\): SUCCESS$
^\[main\.assertion\.3\] .* same prvalue type kept \(/7.1\): SUCCESS$
^\[main\.assertion\.4\] .* double, float: double: SUCCESS$
^\[main\.assertion\.5\] .* int, unsigned: unsigned: SUCCESS$
^\[main\.assertion\.6\] .* enum, long: long: SUCCESS$
^\[main\.assertion\.7\] .* value converted to unsigned: SUCCESS$
^\[main\.assertion\.8\] .* value and size: SUCCESS$
^\[main\.assertion\.9\] .* WRONG \(must FAIL\): FAILURE$
^VERIFICATION FAILED$
^EXIT=10$
^SIGNAL=0$
--
^warning: ignoring
^CONVERSION ERROR$
