; Z3#5911: operations on non-standard FP sort (_ FloatingPoint 2 6)
(set-logic QF_FP)
(declare-fun x () (_ FloatingPoint 2 6))
(declare-fun y () (_ FloatingPoint 2 6))
(assert (not (fp.isNaN x)))
(assert (not (fp.isNaN y)))
(assert (fp.gt (fp.add RNE x y) x))
(assert (fp.gt y (fp #b0 #b00 #b00000)))
(check-sat)
