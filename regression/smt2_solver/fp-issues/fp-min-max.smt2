; Test fp.min and fp.max with various cases
(set-logic QF_FP)

; min(1.0, 2.0) = 1.0
(assert (fp.eq (fp.min
  (fp #b0 #b01111111 #b00000000000000000000000)
  (fp #b0 #b10000000 #b00000000000000000000000))
  (fp #b0 #b01111111 #b00000000000000000000000)))

; max(1.0, 2.0) = 2.0
(assert (fp.eq (fp.max
  (fp #b0 #b01111111 #b00000000000000000000000)
  (fp #b0 #b10000000 #b00000000000000000000000))
  (fp #b0 #b10000000 #b00000000000000000000000)))

; min(-0, +0) = -0
(assert (fp.isNegative (fp.min
  (fp #b1 #b00000000 #b00000000000000000000000)
  (fp #b0 #b00000000 #b00000000000000000000000))))

; max(-0, +0) = +0
(assert (fp.isPositive (fp.max
  (fp #b1 #b00000000 #b00000000000000000000000)
  (fp #b0 #b00000000 #b00000000000000000000000))))

; min(NaN, 1.0) = 1.0
(assert (fp.eq (fp.min (_ NaN 8 24)
  (fp #b0 #b01111111 #b00000000000000000000000))
  (fp #b0 #b01111111 #b00000000000000000000000)))

; max(NaN, 1.0) = 1.0
(assert (fp.eq (fp.max (_ NaN 8 24)
  (fp #b0 #b01111111 #b00000000000000000000000))
  (fp #b0 #b01111111 #b00000000000000000000000)))

(check-sat)
