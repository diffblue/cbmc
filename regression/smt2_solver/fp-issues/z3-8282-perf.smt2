; Z3#8282: basic FP formula (performance baseline)
(set-logic QF_FP)
(declare-const a (_ FloatingPoint 8 24))
(declare-const b (_ FloatingPoint 8 24))
(assert (not (fp.isNaN a)))
(assert (not (fp.isNaN b)))
(assert (not (fp.isInfinite a)))
(assert (not (fp.isInfinite b)))
(assert (fp.gt (fp.add RNE a b) (fp.mul RNE a b)))
(check-sat)
