main.c
--arrays-uf-always
^\[main.assertion.12\] line 34 assertion arr\[1\].c\[2\] == 0: FAILURE$
^\[main.assertion.13\] line 35 assertion arr\[1\].c\[3\] == 0: FAILURE$
^\[main.assertion.14\] line 36 assertion arr\[1\].c\[4\] == 0: FAILURE$
^\*\* 3 of 21 failed
^VERIFICATION FAILED$
^EXIT=10$
