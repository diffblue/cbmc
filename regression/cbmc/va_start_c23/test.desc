^\[main\.assertion\.1\] line 46 c23_one: SUCCESS$
^\[main\.assertion\.2\] line 47 c23_two: SUCCESS$
^\[main\.assertion\.3\] line 48 c23_zero: SUCCESS$
^\[main\.assertion\.4\] line 49 not_last: SUCCESS$
