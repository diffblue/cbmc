CORE broken-cprover-smt-backend broken-z3-smt-backend no-new-smt
main.c
--show-array-constraints --json-ui
activate-multi-line-match
^EXIT=10$
^SIGNAL=0$
\{\n\s*"arrayConstraints": \{\n\s*("\w+": \d+,?\n\s*)+\},\n\s*"numOfConstraints": \d+\n\s*\}
