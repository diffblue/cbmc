CORE dfcc-only
main.c
--dfcc main --apply-loop-contracts
^EXIT=10$
^SIGNAL=0$
^VERIFICATION FAILED$
^\[main\.assertion\.\d+\] line \d+ assertion \*\*pp == 0: FAILURE$
--
--
Checks that a read through a pointer to a pointer counts as a read of the
variables the inner pointer may point to: `t` holds the value of the previous
iteration when it is read through `pp`, so it is not a loop local.
