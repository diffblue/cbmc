CORE dfcc-only
main.c
--dfcc main --apply-loop-contracts
^EXIT=10$
^SIGNAL=0$
^VERIFICATION FAILED$
^\[main\.assertion\.\d+\] line \d+ assertion \*\(unsigned \*\)bits == 0: FAILURE$
--
--
Checks that a variable whose address is taken is not a loop local when a
pointer obtained from an integer may point to it.
