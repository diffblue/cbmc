CORE dfcc-only
main.c
--dfcc main --apply-loop-contracts
^EXIT=10$
^SIGNAL=0$
^VERIFICATION FAILED$
^\[check\.assertion\.\d+\] line \d+ assertion \*\*saved == 0: FAILURE$
--
--
Checks that storing an address in a local pointer whose own address escaped
(before the loop) escapes it: `check` reads the previous iteration's `t`
through `saved`, so `t` is not a loop local.
