CORE dfcc-only
main.c
--dfcc main --enforce-contract callee
^\[two\.assigns\.\d+\] line 14 Check that g is assignable: SUCCESS$
^EXIT=0$
^SIGNAL=0$
^VERIFICATION SUCCESSFUL$
--
--
A call with fewer arguments than the callee has parameters: the write set has
to bind to the write set parameter rather than to the missing parameter b.
