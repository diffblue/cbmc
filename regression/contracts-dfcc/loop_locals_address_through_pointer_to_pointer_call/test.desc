CORE dfcc-only
main.c
--dfcc main --apply-loop-contracts
^EXIT=10$
^SIGNAL=0$
^VERIFICATION FAILED$
^\[check\.assertion\.\d+\] line \d+ assertion \*\*q == 0: FAILURE$
--
--
Checks that passing a pointer to a pointer to a function escapes the
variables the inner pointer may point to: `check` reads the previous
iteration's `t`, so it is not a loop local.
