+Clause *Internal::learn_gauss_reason_clause(int ilit) {
+  if (!gauss) return nullptr;
+  int elit = externalize(ilit);
+  auto reason = gauss->get_reason(elit);
+  if (reason.size() <= 1) return nullptr;
+  auto clause_save = std::move(clause);
+  clause.clear();
+  for (int el : reason) {
+    int eidx2 = abs(el);
+    if ((size_t)eidx2 >= external->e2i.size()) continue;
+    int il = external->e2i[eidx2];
+    if (el < 0) il = -il;
+    if (!il) continue;
+    clause.push_back(il);
+  }
+  if (clause.size() <= 1) { clause = std::move(clause_save); return nullptr; }
+  int best = 1, best_lev = var(clause[1]).level;
+  for (size_t k = 2; k < clause.size(); k++) {
+    int lev = var(clause[k]).level;
+    if (lev > best_lev) { best_lev = lev; best = k; }
+  }
+  if (best != 1) std::swap(clause[1], clause[best]);
+  Clause *c = new_clause(true, 1);
+  watch_clause(c);
+  clause = std::move(clause_save);
+  return c;
+}

