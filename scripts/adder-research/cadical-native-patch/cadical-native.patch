+void Solver::add_xor(const std::vector<int> &lits, bool rhs) {
+  if (!internal->gauss)
+    internal->gauss = new GaussPropagator();
+  std::vector<unsigned> vars;
+  bool adjusted_rhs = rhs;
+  for (int lit : lits) {
+    vars.push_back(static_cast<unsigned>(abs(lit)));
+    if (lit < 0) adjusted_rhs = !adjusted_rhs;
+  }
+  internal->gauss->add_xor(vars, adjusted_rhs);
+}

