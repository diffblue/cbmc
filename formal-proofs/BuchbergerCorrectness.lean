/-
  Formalization of the Buchberger algorithm's ideal preservation
  property. We prove that the algorithm maintains ⟨G⟩ = ⟨F⟩.

  We work abstractly with ideals rather than with specific polynomial
  representations, making the proofs applicable to any commutative ring.
-/

import GroebnerSoundness
import Mathlib.RingTheory.Ideal.Basic
import Mathlib.Tactic

variable {R : Type*} [CommRing R]

/-! ## Core invariant: operations preserve ideal membership -/

/-- S-polynomial (linear combination) preserves ideal membership. -/
theorem s_poly_in_ideal (I : Ideal R) {f g : R} (hf : f ∈ I) (hg : g ∈ I)
    (a b : R) : a * f - b * g ∈ I :=
  I.sub_mem (I.mul_mem_left a hf) (I.mul_mem_left b hg)

/-- Reduction preserves ideal membership. -/
theorem reduce_in_ideal (I : Ideal R) {h g : R} (hh : h ∈ I) (hg : g ∈ I)
    (q : R) : h - q * g ∈ I :=
  I.sub_mem hh (I.mul_mem_left q hg)

/-- Scalar multiplication preserves ideal membership (the "2-trick"). -/
theorem scale_in_ideal (I : Ideal R) {f : R} (hf : f ∈ I)
    (c : R) : c * f ∈ I :=
  I.mul_mem_left c hf

/-! ## Ideal generated by a set grows monotonically with the set -/

/-- If S ⊆ T, then Ideal.span S ≤ Ideal.span T. -/
theorem span_mono_of_subset {S T : Set R} (h : S ⊆ T) :
    Ideal.span S ≤ Ideal.span T :=
  Ideal.span_mono h

/-! ## Adding an element in the ideal doesn't change the ideal -/

/-- If x ∈ Ideal.span S, then Ideal.span (S ∪ {x}) = Ideal.span S. -/
theorem span_insert_of_mem {S : Set R} {x : R}
    (hx : x ∈ Ideal.span S) :
    Ideal.span (insert x S) = Ideal.span S := by
  apply le_antisymm
  · apply Ideal.span_le.mpr
    intro y hy
    cases hy with
    | inl h => exact h ▸ hx
    | inr h => exact Ideal.subset_span h
  · exact Ideal.span_mono (Set.subset_insert x S)

/-! ## The Buchberger algorithm correctness -/

/-- **Buchberger correctness (abstract version).**

    If the algorithm starts with a set F and produces a set G such that:
    1. F ⊆ G (inputs are never removed)
    2. Every element of G is in Ideal.span F

    Then Ideal.span G = Ideal.span F. -/
theorem buchberger_ideal_preservation {F G : Set R}
    (h_subset : F ⊆ G)
    (h_in_ideal : ∀ g ∈ G, g ∈ Ideal.span F) :
    Ideal.span G = Ideal.span F := by
  apply le_antisymm
  · exact Ideal.span_le.mpr h_in_ideal
  · exact Ideal.span_mono h_subset

/-- **Buchberger UNSAT (abstract version).**

    If the algorithm produces a basis G containing a unit, and
    G generates the same ideal as the input F, then the input
    system has no solution. -/
theorem buchberger_unsat' [Nontrivial R] {F G : Set R}
    (h_subset : F ⊆ G)
    (h_in_ideal : ∀ g ∈ G, g ∈ Ideal.span F)
    {u : R} (hu : IsUnit u) (hu_mem : u ∈ G) :
    Ideal.span F = ⊤ := by
  rw [← buchberger_ideal_preservation h_subset h_in_ideal]
  exact ideal_eq_top_of_unit_mem _ hu (Ideal.subset_span hu_mem)
